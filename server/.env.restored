# Copy to .env and fill in.
PORT=4000
NODE_ENV=development


# Auth
JWT_SECRET=e0a2b8dde4e0b77c3b7d1c51769f8188786e3a38475717c2b153ca7e722d667ef4b37fdc78452a252433ff52eff84303
JWT_EXPIRES_IN=30d

# Comma-separated origins allowed by CORS (Expo web dev server, etc.)
CORS_ORIGINS=http://localhost:8081,http://localhost:19006

# Public base URL used to build links to uploaded files
PUBLIC_URL=http://localhost:4000


# Supabase Postgres: dashboard → Connect → Session pooler URI (port 5432), with your DB password filled in.
DATABASE_URL=
DB_SCHEMA=tumbuna

# Optional: Supabase Storage for uploads (Project Settings → API). Leave blank to use ./uploads.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=tumbuna-media
