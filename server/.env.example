# Copy to .env and fill in.
PORT=4000
NODE_ENV=development

# Supabase Postgres. In the dashboard: Connect → Session pooler (port 5432), or the direct connection.
# The transaction pooler (port 6543) won't work: the API sets search_path per connection and uses row locks.
DATABASE_URL=postgresql://postgres.<project-ref>:<db-password>@aws-0-<region>.pooler.supabase.com:5432/postgres
# Tables live in this schema, not public, so Supabase's REST API doesn't expose them. Tests use tumbuna_test.
DB_SCHEMA=tumbuna

# Auth
JWT_SECRET=replace-with-a-long-random-string
JWT_EXPIRES_IN=30d

# Comma-separated origins allowed by CORS (Expo web dev server, etc.)
CORS_ORIGINS=http://localhost:8081

# Public base URL used to build links to uploaded files
PUBLIC_URL=http://localhost:4000

# Optional: store uploads in Supabase Storage instead of ./uploads (Project Settings → API).
# The service role key bypasses all access rules: keep it on the server only.
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=tumbuna-media
